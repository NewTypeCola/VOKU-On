# Supabase Free project -> Settings -> API. Browser-safe publishable key only.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# No service_role key or database password belongs in VITE_ variables.

# Enable each provider only after its external configuration and live verification.
VITE_KAKAO_LOGIN_ENABLED=true
VITE_GOOGLE_LOGIN_ENABLED=false
# Requires custom SMTP, confirmation enabled, and confirmation/recovery email templates.
VITE_EMAIL_SIGNUP_ENABLED=false
